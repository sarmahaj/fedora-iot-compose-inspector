# Environment Variables Template
# Copy this file to .env and fill in your actual values

# --- AI Configuration (Claude on Vertex AI) ---
# GCP project with Claude access (uses application default credentials)
ANTHROPIC_VERTEX_PROJECT_ID="itpc-ca-b7a2ceb3c4"
# Claude model to use
AI_MODEL="claude-sonnet-4-5@20250929"
# Alternatives: claude-opus-4-6, claude-haiku-4-5@20251001
# For local development: authentication is automatic via gcloud
# For GitHub Actions: set GCP_SA_KEY secret with the service account JSON key

# --- GitHub Token for API access ---
# (get from https://github.com/settings/tokens)
MY_GITHUB_TOKEN="your_github_token_here"

# --- Slack Webhook URL for notifications ---
# (get from your Slack app settings)
SLACK_WEBHOOK_URL="your_slack_webhook_url_here"
