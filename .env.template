# Environment Variables Template
# Copy this file to .env and fill in your actual values

# --- AI Configuration (Claude on Vertex AI) ---
# GCP project with Claude access
GCP_PROJECT_ID="itpc-gcp-core-pe-eng-claude"
# Region where Claude is available
GCP_REGION="global"
# Claude model to use
AI_MODEL="claude-sonnet-4-6"
# For local development: run `gcloud auth application-default login` to authenticate
# For GitHub Actions: set GCP_SA_KEY secret with the service account JSON key

# --- GitHub Token for API access ---
# (get from https://github.com/settings/tokens)
MY_GITHUB_TOKEN="your_github_token_here"

# --- Slack Webhook URL for notifications ---
# (get from your Slack app settings)
SLACK_WEBHOOK_URL="your_slack_webhook_url_here"
